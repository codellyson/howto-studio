{
  "name": "howto-studio",
  "version": "0.1.2",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev --port 4700",
    "build": "nuxt build",
    "test": "node --test test/*.test.ts",
    "postinstall": "nuxt prepare",
    "site:build": "tailwindcss -i site/style.css -o site/dist/style.css --minify && cp site/index.html site/dist/ && cp -R site/img site/dist/"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  }
}
