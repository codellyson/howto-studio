{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "How-to Studio",
  "version": "0.1.1",
  "identifier": "com.kreativekorna.howto-studio",
  "build": {
    "frontendDist": "loading",
    "beforeBuildCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)\" && sh desktop/stage-engine.sh'"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "How-to Studio",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "theme": "Dark",
        "backgroundColor": "#0E0E10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": {
      "engine/": "engine/"
    }
  }
}
